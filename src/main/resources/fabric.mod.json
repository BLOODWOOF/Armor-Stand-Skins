{
	"schemaVersion": 1,
	"id": "pasheadskins",
	"version": "${version}",
	"name": "Head Skins",
	"description": "Armor stands wearing a player head render as that player. Optional Armor Poser toggle to turn the skin off per stand.",
	"authors": [
		"BLOODWOLF"
	],
	"contact": {
		"homepage": "https://modrinth.com/user/BLOODWOOF",
		"sources": "https://github.com/BLOODWOOF/PAS-head-companion"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pasheadskins.PasHeadSkins"
		],
		"client": [
			"pasheadskins.PasHeadSkinsClient"
		]
	},
	"mixins": [
		"pasheadskins.mixins.json",
		{
			"config": "pasheadskins.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"armorposer": "*",
		"skinlayers3d": "*"
	}
}
